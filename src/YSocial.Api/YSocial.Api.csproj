    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YSocial.Application\YSocial.Application.csproj" />
    <ProjectReference Include="..\YSocial.Infrastructure\YSocial.Infrastructure.csproj" />
  </ItemGroup>

</Project>
