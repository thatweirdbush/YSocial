# BE origin (default: https://localhost:49895)
NEXT_PUBLIC_API_BASE_URL=https://localhost:49895

# Cumulative list of slices served by the real BE. UNSET = all slices real (default)
# Supported: auth | auth,content | auth,content,graph | auth,content,graph,activity
# Mock adapters only (no BE needed): none  (an empty value also works in a .env file, but shells delete empty variables)
# NEXT_PUBLIC_REAL_API_SLICES=none

# Cloud name of the media CDN (public, NOT a secret). Set it so the image loader only optimizes OUR cloud (unset = any res.cloudinary.com cloud)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
